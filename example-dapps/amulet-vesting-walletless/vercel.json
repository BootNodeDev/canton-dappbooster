{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "cd ../.. && pnpm -r --filter '@bootnodedev/canton-example-amulet-vesting-walletless...' run --if-present build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://walletless.validator.devnet.canton.bootnode.dev/api/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
