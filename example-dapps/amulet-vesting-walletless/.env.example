###############################################################################
# Participant
###############################################################################
CANTON_JSON_API_URL=http://localhost:2975
SPLICE_SCAN_API_URL=http://scan.localhost:4000/api/scan

###############################################################################
# Scripts / token generation
###############################################################################
CANTON_AUTH_AUDIENCE=https://canton.network.global
# Never copy CANTON_AUTH_SECRET into a browser.
CANTON_AUTH_SECRET=unsafe
# A JWT your participant accepts. On a LocalNet the stack fills it in, or run `pnpm mint-token`.
CANTON_BACKEND_TOKEN=

###############################################################################
# DAML build (pnpm build-dar)
###############################################################################
# Without the local network, the Splice release your network runs, e.g. 0.8.1
# SPLICE_TAG=

###############################################################################
# Server (pnpm stack:up)
###############################################################################
WL_SERVER_PORT=3040
# Empty: the Postgres in server/compose.yaml, on localhost:5433.
DATABASE_URL=
# true once the app is served over https, so the session cookie never travels in clear.
WL_COOKIE_SECURE=false

###############################################################################
# Hosted validator
###############################################################################
# Setting any of these makes the server fetch its ledger token by client-credentials grant
# instead of minting one, and CANTON_JSON_API_URL and SPLICE_SCAN_API_URL then have no default.
# EXTERNAL_OAUTH_TOKEN_URL=
# EXTERNAL_OAUTH_CLIENT_ID=
# EXTERNAL_OAUTH_CLIENT_SECRET=
# EXTERNAL_OAUTH_AUDIENCE=
# EXTERNAL_OAUTH_SCOPE=daml_ledger_api
