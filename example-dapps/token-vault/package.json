{
  "name": "@bootnodedev/canton-example-token-vault",
  "version": "0.7.0",
  "description": "Token vault dApp over a canton-token-forge token, deposit for shares and redeem them: an example app for create-canton-dappbooster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootNodeDev/canton-dappbooster.git",
    "directory": "example-dapps/token-vault"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.html",
    "public",
    "src",
    "vendor",
    "scripts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "vite.config.ts",
    ".env.example",
    "_gitignore",
    "_pnpm-workspace.yaml"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "bootstrap": "node scripts/bootstrap-vault.mjs",
    "stack:up": "bash scripts/operator.sh start",
    "stack:down": "bash scripts/operator.sh stop"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@bootnodedev/canton-connect": "^0.7.0",
    "@bootnodedev/canton-dappbooster": "^0.7.0",
    "@bootnodedev/canton-theme": "^0.7.0",
    "@canton-network/dapp-sdk": "1.8.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@walletconnect/sign-client": "^2.23.9",
    "boring-avatars": "^2.0.4",
    "lucide-react": "^1.39.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
