    "token-standard",
    "canton-token-forge"
  ],
  "homepage": "https://github.com/BootNodeDev/canton-dappbooster/tree/main/example-dapps/token-vault#readme",
  "bugs": {
    "url": "https://github.com/BootNodeDev/canton-dappbooster/issues"
  },
