{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@bootnodedev/canton-token-forge", "@bootnodedev/canton-wallet-service"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs!", "kit/**/*.mjs!", ".lintstagedrc.format.mjs"]
    },
    "canton-connect": {
      "entry": ["src/**/*.test.{ts,tsx}"]
    },
    "canton-dappbooster": {
      "entry": ["src/**/*.test.{ts,tsx}", "scripts/*.mjs!"]
    },
    "dapp/frontend": {
      "entry": ["api/**/*.ts"]
    }
  }
}
