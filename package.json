{
  "name": "cn-dappbooster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "mint-token": "node scripts/mint-token.mjs ledger-api-user",
    "build-dar": "pnpm -C dapp/daml run build",
    "deploy-dar": "bash scripts/deploy-dar.sh",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-vesting-lite.mjs",
    "app:dev": "pnpm -C dapp/frontend run dev -- --host localhost --port 3012 --strictPort",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "typecheck": "pnpm -r run --if-present typecheck",
    "build": "pnpm -r run --if-present build",
    "test": "pnpm -r run --if-present test && node --test \"scripts/*.test.mjs\"",
    "knip": "knip",
    "docs:check": "typedoc --emit none && node scripts/docs-check.mjs",
    "docs:build": "typedoc",
    "check:anatomy": "node scripts/check-anatomy.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@bootnodedev/canton-wallet-service": "git+ssh://git@github.com/BootNodeDev/canton-wallet-service.git#v0.1.2",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "husky": "^9.1.7",
    "knip": "6.32.2",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.26",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
