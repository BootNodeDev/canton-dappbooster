{
  "name": "cn-dappbooster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "canton:up": "pnpm -C canton-barebones run up",
    "canton:down": "pnpm -C canton-barebones run down",
    "canton:health": "pnpm -C canton-barebones run health",
    "canton:token": "pnpm -C canton-barebones run token",
    "build-dar": "bash scripts/build-dar.sh",
    "deploy-dar": "bash canton-barebones/scripts/deploy-dar.sh",
    "wallet-service:dev": "pnpm -C canton-barebones/wallet-service run dev",
    "wallet-service:health": "curl -fsS http://localhost:3010/health",
    "app:dev": "pnpm -C dapp/frontend run dev -- --host localhost --port 3012 --strictPort",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "pnpm -r run --if-present typecheck",
    "build": "pnpm -r run --if-present build",
    "test": "pnpm -r run --if-present test",
    "knip": "knip",
    "docs:check": "typedoc --emit none && node scripts/docs-check.mjs",
    "docs:build": "typedoc",
    "check:anatomy": "node scripts/check-anatomy.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@mermaid-js/mermaid-cli": "^11.15.0",
    "husky": "^9.1.7",
    "knip": "6.32.2",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.26",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
