{
  "name": "cn-dappbooster",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "app:dev": "pnpm -C example-dapps/amulet-vesting run dev",
    "bootstrap": "pnpm -C example-dapps/amulet-vesting run bootstrap",
    "build-dar": "CANTON_APP_DIR=$PWD/example-dapps/amulet-vesting pnpm -C canton-create/scaffold/daml-tooling run build-dar",
    "build": "pnpm -r run --if-present build",
    "check:anatomy": "node scripts/check-anatomy.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "deploy-dar": "CANTON_APP_DIR=$PWD/example-dapps/amulet-vesting bash canton-create/scaffold/daml-tooling/scripts/deploy-dar.sh",
    "docs:build": "typedoc --options scripts/typedoc.json",
    "docs:check": "typedoc --options scripts/typedoc.json --emit none && node scripts/docs-check.mjs",
    "knip": "knip",
    "lint:fix": "biome check --write",
    "lint": "biome check --error-on-warnings",
    "mint-token": "CANTON_APP_DIR=$PWD/example-dapps/amulet-vesting pnpm -C canton-create/scaffold/localnet run mint-token",
    "prepare": "husky",
    "release": "pnpm -r publish --no-git-checks",
    "release:dry": "pnpm -r publish --dry-run --no-git-checks",
    "release:version": "node scripts/release-version.mjs",
    "dev:amulet-vesting": "CANTON_APP_DIR=$PWD/example-dapps/amulet-vesting bash canton-create/scaffold/localnet/scripts/dev-stack.sh",
    "starter:dev": "pnpm -C canton-create/scaffold/starter run dev",
    "test": "pnpm -r run --if-present test && node --test \"canton-create/scaffold/*/scripts/*.test.mjs\" \"scripts/*.test.mjs\"",
    "typecheck": "pnpm -r run --if-present typecheck",
    "wallet-gateway": "mkdir -p .wallet-gateway && wallet-gateway -c canton-create/scaffold/localnet/wallet-gateway.config.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@canton-network/wallet-gateway-remote": "1.11.3",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "knip": "6.41.0",
    "lint-staged": "^17.0.4",
    "postcss": "^8.5.26",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
