{
  "name": "@bootnodedev/canton-dappbooster",
  "version": "0.5.6",
  "description": "Headless React components for Canton dApps: identifier display, truncation, copy and explorer links, a validated party-id input, a token-amount field, wallet connect buttons, and the exact-decimal amount utilities under them",
  "keywords": [
    "canton",
    "canton-network",
    "splice",
    "dapp",
    "web3",
    "dappbooster",
    "bootnode",
    "react",
    "react-components",
    "headless-ui",
    "components",
    "wallet",
    "cip-0103",
    "typescript"
  ],
  "homepage": "https://components.dappbooster.cc/modules/_bootnodedev_canton-dappbooster.html",
  "bugs": {
    "url": "https://github.com/BootNodeDev/canton-dappbooster/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootNodeDev/canton-dappbooster.git",
    "directory": "canton-dappbooster"
  },
  "license": "MIT",
  "author": "BootNode (https://canton.bootnode.dev/)",
  "scripts": {
    "build": "tsdown",
    "lint:fix": "biome check --write",
    "lint": "biome check",
    "prepack": "tsdown",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./connect": {
        "types": "./dist/connect.d.ts",
        "import": "./dist/connect.js"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24.15.0"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./connect": {
      "development": "./src/connect.ts",
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    }
  },
  "imports": {
    "#src/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@bootnodedev/canton-connect": "^0.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.0",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@bootnodedev/canton-connect": "^0.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@zag-js/dialog": "^1.43.0",
    "@zag-js/react": "^1.43.0"
  }
}
