# Offers a "Mock Wallet" in the wallet picker so the app connects with no wallet reachable.
# Unset it, or set it to anything but `true`, once you have a real wallet to connect.
VITE_MOCK_WALLET=true

# Lists a Wallet Gateway (https://github.com/canton-network/wallet) in the picker. A session
# survives a reload only for a gateway listed here.
# VITE_WALLET_GATEWAY_URL=http://localhost:3030/api/v0/dapp
