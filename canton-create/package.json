{
  "name": "create-canton-dappbooster",
  "version": "0.5.6",
  "description": "Scaffold a Canton dApp: a React + Vite app on the Canton dApp kit, optionally with a full local network",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BootNodeDev/canton-dappbooster.git",
    "directory": "canton-create"
  },
  "license": "MIT",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-canton-dappbooster": "./dist/index.js"
  },
  "files": [
    "dist",
    "scaffold",
    "!scaffold/*/node_modules",
    "!scaffold/*/dist",
    "!scaffold/*/daml/.daml",
    "!scaffold/*/daml/deps",
    "!scaffold/*/scripts/*.test.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "try": "bash scripts/try.sh",
    "try:clean": "bash scripts/try.sh clean"
  },
  "imports": {
    "#src/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "devDependencies": {
    "@inkjs/ui": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "ink": "^8.0.0",
    "ink-gradient": "^4.0.1",
    "ink-link": "^5.0.0",
    "ink-testing-library": "^4.0.0",
    "react": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
