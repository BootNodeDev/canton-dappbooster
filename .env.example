# Wallet service
CANTON_JSON_API_URL=http://localhost:2975
CANTON_LEDGER_API_URL=grpc://localhost:2901
CANTON_ADMIN_API_URL=grpc://localhost:2902
SPLICE_VALIDATOR_URL=http://localhost:2000/api/validator
SPLICE_SCAN_API_URL=http://scan.localhost:4000/api/scan
SPLICE_REGISTRY_API_URL=http://localhost:2000/api/validator/v0/scan-proxy
WALLET_SERVICE_PORT=3010
NETWORK=canton:localnet
WALLET_PROVIDER_URL=http://localhost:3010
WALLET_PROVIDER_USER_URL=http://localhost:3010

# LocalNet dev JWT recipe, read by `scripts/mint-token.mjs`
# Never copy CANTON_AUTH_SECRET into a browser.
CANTON_AUTH_AUDIENCE=https://canton.network.global
CANTON_AUTH_SECRET=unsafe
# generate with `node scripts/mint-token.mjs ledger-api-user`
CANTON_BACKEND_TOKEN=

# Where `pnpm run bootstrap` reaches wallet-service; defaults to this if unset.
#RPC_URL=http://localhost:3010/rpc

# dApp build-time settings. Vite reads them from this file and inlines them, so a change needs a
# restart. Both have defaults, so a fresh clone runs with neither set.

# Splice Scan, where the dApp links party ids and contracts for a human to look at.
VITE_EXPLORER_URL=http://scan.localhost:4000

# wallet-service's JSON-RPC endpoint, where the dApp builds the AmuletRules and open-mining-round
# disclosures every Amulet-moving write carries. A deployed build sets this to `/api/rpc` instead,
# the same-origin function that forwards server-side, since an https page cannot call plain http.
VITE_WALLET_RPC_URL=http://localhost:3010/rpc

# Read by that function, on the Vercel project only. Deliberately not a VITE_ name: the upstream
# address must not reach the bundle.
#WALLET_SERVICE_RPC_URL=http://<wallet-service host>:3010/rpc
