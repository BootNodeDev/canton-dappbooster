###############################################################################
# Participant
###############################################################################
CANTON_JSON_API_URL=http://localhost:2975
SPLICE_SCAN_API_URL=http://scan.localhost:4000/api/scan
SPLICE_REGISTRY_API_URL=http://localhost:2000/api/validator/v0/scan-proxy

###############################################################################
# Scripts / token generation
###############################################################################
CANTON_AUTH_AUDIENCE=https://canton.network.global
# Never copy CANTON_AUTH_SECRET into a browser.
CANTON_AUTH_SECRET=unsafe
# On a LocalNet the stack fills this in; or run `pnpm mint-token`
CANTON_BACKEND_TOKEN=

###############################################################################
# DAML build (pnpm build-dar)
###############################################################################
# Without the local network, the Splice release your network runs, e.g. 0.8.1
# SPLICE_TAG=

###############################################################################
# Frontend
###############################################################################
VITE_EXPLORER_URL=http://scan.localhost:4000
VITE_SCAN_API_URL=http://scan.localhost:4000/api/scan
VITE_WALLET_GATEWAY_URL=http://localhost:3030/api/v0/dapp

###############################################################################
# Wallet Connect
###############################################################################
VITE_NETWORK_ID=canton:local
VITE_WALLET_CONNECT_PROJECT_ID=